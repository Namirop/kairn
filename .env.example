# Copie ce fichier en `.env` et remplis les valeurs. `.env` n'est jamais commité.

# --- Base de données ---------------------------------------------------------
# Connexion applicative. Sur Neon, utiliser l'endpoint *poolé* (hôte en `-pooler`) :
# c'est celui qui tient les nombreuses connexions courtes du runtime serverless.
# Terminer par `?sslmode=verify-full&channel_binding=require`.
DATABASE_URL=
# Connexion directe, sans pooler. Prisma Migrate et le seed en ont besoin :
# le pooler en mode transaction casse les verrous consultatifs des migrations.
DIRECT_URL=

# --- Authentification --------------------------------------------------------
# Secret de signature des sessions better-auth. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# URL publique de l'application, sans slash final. Ex. http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Identifiants OAuth Google. Console Google Cloud > API et services > Identifiants.
# URI de redirection à déclarer : {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Services externes -------------------------------------------------------
ANTHROPIC_API_KEY=
RESEND_API_KEY=
# Expéditeur des emails transactionnels. Le domaine doit être vérifié chez Resend.
EMAIL_FROM=Kairn <bonjour@example.com>
# Destinataire des alertes d'exploitation — plafonds d'appels qui se remplissent.
# Ce n'est pas un compte du produit : personne ne peut la couper depuis un écran
# de réglages. Absente, les alertes ne partent pas et le journal le dit.
EMAIL_ALERTES=
# Jeton partagé des routes cron. Le déclencheur l'envoie en `Authorization: Bearer`.
CRON_SECRET=

# --- Garde-fous IA — voir lib/ai/client.ts -----------------------------------
# Les commentaires sont au-dessus des lignes, jamais à leur suite. dotenv sait
# retirer un `# …` de fin de ligne, l'interface d'un hébergeur non : une valeur
# recopiée d'ici avec son commentaire y arrive entière, et la configuration est
# refusée en production alors qu'elle passait en local.
# true en développement, toujours
MOCK_AI=true
# false coupe tout appel modèle
AI_ENABLED=true
# plafond global d'appels réels par jour
AI_DAILY_CALL_CAP=50
# Ce qu'un seul compte peut prendre dans ce plafond. Le global protège le
# budget, celui-ci protège les utilisateurs les uns des autres : sans lui, un
# compte pouvait vider la journée et fermer le produit à tous les autres.
# À 40 sur 50, il ne protégeait de rien — un seul compte fermait la journée.
AI_DAILY_CALL_CAP_PAR_COMPTE=20
# Ce que la landing peut prendre dans ce plafond, tous visiteurs confondus. Sans
# lui, le trafic public et les comptes se partagent le global sans qu'aucun ne
# soit protégé de l'autre, et le déni de service joue dans les deux sens.
AI_DAILY_CALL_CAP_ANONYME=15
AI_MODEL=claude-sonnet-5
# Une extraction sur un pavé peut rendre douze concepts : une sortie coupée est
# un échec, jamais un résultat partiel. Voir lib/ai/client.ts.
AI_MAX_TOKENS=6000

# --- Banc de mesure : embeddings ---------------------------------------------
# Clé Voyage AI, pour la passe de vecteurs du banc (scripts/mesurer-le-corpus.ts).
# Elle ne sert qu'au banc : ces appels ne passent pas par callAI(), n'entrent dans
# aucun plafond et n'écrivent rien dans AiCall. Le modèle est une constante du
# code — voir scripts/evaluation/mesures/espace.ts —, pas une variable : deux
# modèles produisent des espaces incompatibles, et un seuil calibré sur l'un ne
# veut rien dire sur l'autre.
VOYAGE_IA_KEY=

# --- Vérification en ligne ---------------------------------------------------
# Lève les deux verrous de l'essai anonyme de la landing — le cookie de visite et
# la limite par empreinte d'adresse — le temps d'éprouver le découpage en
# production. Absente, les verrous tiennent : ne la pose que pendant une
# vérification, et retire-la ensuite. Le plafond journalier d'appels au modèle
# reste actif dans tous les cas. Voir lib/depots/essai-sans-limite.ts.
ESSAI_ANONYME_SANS_LIMITE=

# --- Compte de démonstration du seed -----------------------------------------
# Facultatif : sans ces valeurs, prisma/seed/account.ts utilise ses propres
# constantes. Renseigne-les pour un compte de démonstration qui t'appartient.
SEED_USER_EMAIL=
SEED_USER_TIMEZONE=Europe/Brussels
# Adresses autorisées à lire les signalements, séparées par des virgules.
# Vide n'autorise personne : une variable oubliée doit fermer la porte.
ADMIN_EMAILS=
