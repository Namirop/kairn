# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# client Prisma généré
/lib/db/generated

# Config d'assistant et méthodo de travail : présentes sur la machine,
# absentes du dépôt. Voir README pour ce qui fait contrat côté code.
/.claude/
/.windsurf
/.agents
/skills-lock.json
/CLAUDE.md
# Les consignes de phase : elles disent comment le produit a été construit,
# pas ce qu'il fait. Rangées ensemble depuis la phase 4.
/archive/

# Rapports du banc d’évaluation : produits localement, jamais commités.
/scripts/evaluation/rapports/
/scripts/evaluation/concepts/
