/// Forme sous laquelle l'utilisateur a déposé son Input.
enum InputSourceType {
  TEXT
  IMAGE
}

/// Avancement du découpage d'un Input en Atoms.
enum InputStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// État de maîtrise d'un Atom, du point de vue du produit.
enum AtomState {
  LEARNING
  REVIEWING
  CONSOLIDATED
  ARCHIVED
}

/// État interne de la carte pour ts-fsrs. Distinct d'AtomState :
/// l'un décrit le produit, l'autre l'algorithme. Voir lib/domain/fsrs-state.ts.
enum FsrsState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

/// Format de question porté par un Variant.
///
/// Quatre formats se vérifient sans jugement — MCQ, CLOZE, TRUE_FALSE, CODE —
/// et deux se répondent en texte libre, où la personne se note elle-même. Un lot
/// n'en porte qu'un seul du second groupe : voir lib/domain/controle-variants.ts.
enum VariantFormat {
  MCQ
  CLOZE
  TRUE_FALSE
  SHORT_ANSWER
  CODE
  EXPLAIN
}

/// Angle sous lequel un Variant interroge son Atom. C'est la facette, et non le
/// format, qui fait tourner la rotation : servir deux fois le même angle sous
/// deux habillages ne prouve rien de plus que la première fois.
enum VariantFacet {
  /// De quoi s'agit-il, à quoi le reconnaît-on.
  RECOGNITION
  /// Pourquoi ça marche, ce qui se passe réellement.
  MECHANISM
  /// Ce que ce n'est pas, quand ça ne s'applique pas.
  BOUNDARY
  /// S'en servir dans une situation qui n'est pas celle du concept.
  APPLICATION
}

/// Notation donnée par l'utilisateur sur une Review, alignée sur ts-fsrs.
enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

/// Nature du travail confié à un GenerationJob.
enum GenerationKind {
  ATOMS
  VARIANTS
  OCR
}

/// Cycle de vie d'un GenerationJob.
enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// Canal unique pour l'instant : l'email.
enum NotificationType {
  DAILY_REMINDER
}

/// Cycle de vie d'une soumission groupée.
enum BatchStatus {
  SUBMITTED
  ENDED
  FAILED
}
