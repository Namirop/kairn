// La chaîne du produit : Input → Atom → Variant → Review.
// La planification porte sur l'Atom. Aucun champ d'échéance, d'intervalle ou de
// difficulté ne doit apparaître sur Variant : ce serait un bug d'architecture.

model Input {
  id String @id @default(cuid())

  /// À qui ce dépôt appartient : un compte, ou une session anonyme.
  ///
  /// Exactement l'un des deux est renseigné. Un visiteur dépose avant d'avoir un
  /// compte — c'est ce qui lui montre le produit au lieu de le lui promettre —
  /// et son dépôt passe au compte à l'inscription. Les deux colonnes plutôt
  /// qu'un compte fantôme : `User` appartient à better-auth, et y écrire des
  /// visiteurs fausserait tout ce qui compte des comptes.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  anonymousSessionId String?
  anonymousSession   AnonymousSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)

  /// Ce que l'utilisateur a déposé, mot pour mot. Jamais réécrit après création.
  rawContent String          @db.Text
  sourceType InputSourceType

  /// L'image, le temps de la lire, et rien de plus. Une capture montre souvent
  /// plus que ce que son auteur croit y montrer — barre latérale, notifications,
  /// onglets. Ces octets sont effacés dès que `extractedText` est obtenu, et il
  /// n'existe aucune route pour les servir. Ce que l'utilisateur relira, c'est
  /// le texte extrait.
  imageData      Bytes?
  imageMediaType String?
  /// Texte tiré d'une image par l'OCR. Nul pour un Input textuel.
  extractedText  String?     @db.Text
  /// Ce qu'on dit à l'utilisateur quand le dépôt n'a pas abouti.
  failureReason  String?
  status         InputStatus @default(PENDING)

  /// Ce que l'extraction a lu de la nature du dépôt. Elle décide si le doute
  /// écarte un concept de la génération de questions — sans elle, on ne peut
  /// plus reconstruire pourquoi un dépôt n'a rien produit.
  nature InputNature?

  /// L'extraction a rendu plus de concepts que le plafond du produit, et on a
  /// gardé les plus importants. Le compte réellement rendu ne vit pas ici : il
  /// part au journal, parce qu'il sert à savoir si le palier est le bon et que
  /// ce n'est pas une information d'écran.
  conceptsTronques Boolean @default(false)

  /// La capture portait plus de texte qu'un dépôt ne peut en accepter, et la
  /// lecture a été coupée. Distinct du précédent : ce n'est ni la même perte,
  /// ni le même message. Toujours faux sur un dépôt texte, dont la longueur est
  /// refusée avant l'envoi.
  texteTronque Boolean @default(false)

  /// La consigne que la personne a jointe à son dépôt, ou rien.
  ///
  /// Elle ne fait pas partie du dépôt : le dépôt est ce qu'on veut retenir,
  /// elle est ce qu'on dit du dépôt. D'où une colonne à part plutôt qu'un
  /// préfixe collé à `rawContent` — celui-ci est contractuellement « jamais
  /// modifié », et l'écran qui le relit doit montrer le texte, pas la consigne.
  ///
  /// Elle ne sert qu'au découpage, et elle y sert à **restreindre** : écarter
  /// une partie du texte, dire ce qui n'est pas à retenir, préciser le cadre.
  /// Le prompt le dit, et dit aussi qu'elle n'ajoute jamais de contenu — un
  /// concept reste entièrement soutenu par ce qui a été déposé.
  ///
  /// Conservée après coup : c'est ce qui permet au redécoupage de repartir dans
  /// les mêmes termes, et à l'écran du dépôt de montrer ce qu'on avait demandé.
  instruction String?

  /// Ce que la consigne a laissé du dépôt, recopié mot pour mot par l'extraction.
  ///
  /// Une **vue**, jamais une réécriture : `rawContent` reste ce qui a été posé,
  /// et c'est lui qui repart au modèle si l'on redécoupe un jour. Celle-ci ne
  /// sert qu'à l'écran du dépôt, qui montrait le texte entier — barre latérale
  /// comprise — juste au-dessus des concepts tirés de tout autre chose.
  ///
  /// Nulle presque partout : sans consigne, on ne la demande même pas au modèle
  /// (voir `contratDExtraction`), et une consigne qui oriente sans retrancher
  /// n'en produit aucune. Nulle aussi quand le rendu n'a pas passé la garde de
  /// fidélité — voir `texteRetenu`, qui vérifie que chaque ligne vient bien du
  /// dépôt.
  texteRetenu String? @db.Text

  /// Clé d'un envoi, émise par le formulaire. Deux envois du même geste — double
  /// clic, reprise réseau — portent la même et ne créent qu'un dépôt.
  submissionKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  atoms Atom[]
  jobs  GenerationJob[]

  @@unique([userId, submissionKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([anonymousSessionId])
}

model Atom {
  id      String @id @default(cuid())
  inputId String
  input   Input  @relation(fields: [inputId], references: [id], onDelete: Cascade)

  /// Le même couple que sur `Input`, et pour la même raison. Un concept anonyme
  /// est invisible de toute requête de compte : elles filtrent toutes sur
  /// `userId`, et il vaut nul tant que personne ne l'a réclamé.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  anonymousSessionId String?
  anonymousSession   AnonymousSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)

  concept   String   @db.Text
  tags      String[]
  /// Extrait tel qu'il a été déposé alors qu'il paraît factuellement douteux.
  /// Aucune question n'est écrite dessus : river une erreur serait pire que
  /// l'ignorer. Il attend que l'utilisateur confirme, corrige ou supprime.
  uncertain Boolean  @default(false)

  state          AtomState @default(LEARNING)
  archivedAt     DateTime?
  /// Distingue l'archivage décidé par l'utilisateur de celui décidé par le produit.
  archivedByUser Boolean   @default(false)

  /// Dernier passage d'entraînement sur ce concept, tous variants confondus.
  ///
  /// Ce n'est pas de la planification et ça n'en approche pas : aucune échéance
  /// ne le lit. C'est le curseur qui fait tourner l'entraînement — un tour ne
  /// tire que douze questions, il n'a jamais eu besoin de lire tout le corpus,
  /// et servir d'abord ce qui a été travaillé il y a le plus longtemps borne la
  /// lecture sans que personne ne sorte jamais de la rotation.
  trainedAt DateTime?

  /// Quand la carte « tu maîtrises ça » a été montrée pour ce concept.
  /// Ce qui est rare fait plaisir : sans cette trace, le même concept
  /// rappellerait sa victoire à chaque série qui accélère, et la carte
  /// deviendrait le bruit qu'on apprend à ignorer.
  masterySignaledAt DateTime?

  // Carte ts-fsrs. Ces champs sont écrits par l'algorithme, jamais à la main.
  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Int       @default(0)
  scheduledDays Int       @default(0)
  /// Exigé par ts-fsrs 5 en plus des champs historiques.
  learningSteps Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  fsrsState     FsrsState @default(NEW)
  lastReview    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants Variant[]
  reviews  Review[]

  /// La requête chaude de toute l'application : les Atoms dus d'un utilisateur.
  @@index([userId, due])
  @@index([userId, state])
  @@index([inputId])
  @@index([anonymousSessionId])
  /// La fenêtre d'un tour d'entraînement : le moins récemment travaillé d'abord.
  @@index([userId, trainedAt])
}

model Variant {
  id     String @id @default(cuid())
  atomId String
  atom   Atom   @relation(fields: [atomId], references: [id], onDelete: Cascade)

  format    VariantFormat
  /// L'angle interrogé. La rotation sert une facette différente à chaque
  /// passage : c'est elle qui empêche de réciter, pas le changement de format.
  facet     VariantFacet
  question  String        @db.Text
  answerKey String        @db.Text
  /// Données propres au format : options d'un QCM, langage d'un extrait de code.
  payload   Json?

  /// Passages en session du jour. C'est le seul compteur que lit la rotation :
  /// tourner dix fois sur un concept à l'entraînement ne doit pas décider de la
  /// formulation qu'on servira demain.
  sessionCount  Int       @default(0)
  lastSessionAt DateTime?
  /// Passages en entraînement libre. Il ne pilote rien, il use : additionné au
  /// premier, il dit quand les formulations ont fait leur temps.
  trainingCount Int       @default(0)
  lastTrainedAt DateTime?
  /// Un Variant retiré n'est plus proposé mais reste lié à ses Reviews passées.
  retiredAt     DateTime?

  /// Sous quel réglage cette question a été écrite.
  ///
  /// C'est la donnée qu'on oublie de garder et la plus utile le jour où une
  /// question part en vrille : sans elle, on ne sait pas si le défaut vient d'un
  /// réglage déjà corrigé. Une empreinte du prompt plutôt qu'un numéro à
  /// incrémenter, pour qu'elle change exactement quand le prompt change et jamais
  /// parce qu'on a pensé à la bumper. Le modèle est posé ici pour la même raison :
  /// celui d'aujourd'hui ne dit rien de celui qui a écrit cette question-là.
  promptVersion String?
  model         String?

  createdAt DateTime @default(now())

  reviews Review[]
  reports Signalement[]

  @@index([atomId, retiredAt])
}

model Review {
  id        String  @id @default(cuid())
  atomId    String
  atom      Atom    @relation(fields: [atomId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating          ReviewRating
  responseTimeMs  Int
  /// Sous quel mode ce passage a eu lieu. Un passage d'entraînement est de
  /// l'histoire, jamais de la planification : il n'a déplacé aucune échéance.
  mode            ReviewMode   @default(SESSION)
  /// L'utilisateur a déclaré maîtriser le concept et l'a sorti du cycle.
  selfMastered    Boolean      @default(false)
  /// Stabilité de l'Atom avant et après le passage, pour rejouer une courbe.
  stabilityBefore Float
  stabilityAfter  Float

  reviewedAt DateTime @default(now())

  @@index([userId, reviewedAt])
  @@index([atomId, reviewedAt])
}
