// Ce qui fait tourner le produit sans être le produit : travail asynchrone,
// traçabilité des appels modèle, quotas, envois d'emails.

model GenerationJob {
  id      String @id @default(cuid())
  inputId String
  input   Input  @relation(fields: [inputId], references: [id], onDelete: Cascade)

  kind      GenerationKind
  status    JobStatus      @default(QUEUED)
  attempts  Int            @default(0)
  lastError String?        @db.Text

  /// Les Atoms qu'un job de variantes couvre, trois au plus. Vide ailleurs.
  atomIds String[]

  /// Le lot qui porte ce job, quand il est parti en soumission groupée.
  batchId String?
  batch   AiBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  aiCalls AiCall[]

  /// Requête du cron de reprise : les jobs à relancer, les plus vieux d'abord.
  @@index([status, createdAt])
  @@index([inputId])
  @@index([batchId])
}

/// Une soumission groupée au modèle : plusieurs requêtes, un seul envoi, moitié
/// tarif contre une latence de quelques minutes à quelques heures.
///
/// Les questions ne servent qu'à la première révision, au plus tôt le lendemain.
/// Elles peuvent attendre ; les concepts, eux, sont le retour visible du dépôt
/// et restent en appel normal.
model AiBatch {
  id String @id @default(cuid())

  /// Identifiant rendu par la plateforme, celui qu'on interroge.
  providerId String      @unique
  status     BatchStatus @default(SUBMITTED)
  /// Nombre de requêtes du lot. Chacune a pris une place au plafond du jour.
  requests   Int

  createdAt DateTime  @default(now())
  polledAt  DateTime?
  endedAt   DateTime?

  jobs GenerationJob[]

  /// Requête du cron de relève : les lots encore ouverts, les plus vieux d'abord.
  @@index([status, createdAt])
}

/// Les gens qui veulent plus que le plafond du jour. Une table et un bouton :
/// un signal de demande gratuit, bien avant d'avoir quoi que ce soit à vendre.
model WaitlistEntry {
  userId String   @id
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  motif  String?
  askedAt DateTime @default(now())
}

/// Réservation des appels modèle de la journée, en UTC. Une ligne par jour,
/// globale au produit.
///
/// Ce modèle existe parce que compter les lignes d'`AiCall` avant d'émettre est
/// une course : deux appels simultanés lisent la même valeur et passent tous les
/// deux. Ici, prendre sa place est une seule instruction SQL qui incrémente et
/// refuse dans le même mouvement. La place est prise avant l'émission et n'est
/// jamais rendue — un appel qui échoue a pu consommer des tokens.
model AiCallQuota {
  /// Minuit UTC du jour concerné.
  day DateTime @id @db.Date

  reserved Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Une ligne par appel réel au modèle, succès comme échec. C'est le registre
/// qui sert la comptabilité et l'observation ; l'autorisation, elle, passe par
/// `AiCallQuota`.
model AiCall {
  id String @id @default(cuid())

  /// Nuls tous les deux si l'appel ne vient pas d'un utilisateur ou d'un job.
  /// Détachés plutôt que supprimés : la comptabilité survit à la suppression.
  userId String?
  user   User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  jobId  String?
  job    GenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  purpose String
  model   String
  /// Entrée facturée plein tarif : ce que le cache n'a pas couvert.
  inputTokens         Int
  /// Entrée écrite dans le cache, facturée un quart plus cher.
  cacheCreationTokens Int     @default(0)
  /// Entrée lue depuis le cache, facturée un dixième.
  cacheReadTokens     Int     @default(0)
  outputTokens        Int
  costUsd             Decimal @db.Decimal(12, 8)
  latencyMs    Int
  success      Boolean
  errorCode    String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Compteurs par utilisateur et par jour, pour les quotas d'usage.
model DailyUsage {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Date locale de l'utilisateur.
  day    DateTime @db.Date

  /// Dépôts écrits dans la journée. Second rideau du quota : chaque dépôt paie
  /// une extraction, quoi qu'elle rende.
  generations Int @default(0)
  /// Concepts retenus dans la journée. C'est le vrai plafond : le concept est
  /// ce qui coûte, et la bonne unité pour l'utilisateur.
  concepts    Int @default(0)
  reviews     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, day])
}

/// Rend le cron de notification idempotent : la clé primaire interdit deux
/// envois du même type au même utilisateur le même jour.
model EmailDelivery {
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  /// Date locale de l'utilisateur au moment de l'envoi.
  day    DateTime         @db.Date

  sentAt     DateTime @default(now())
  /// Identifiant renvoyé par Resend, pour retrouver un envoi côté fournisseur.
  providerId String?

  @@id([userId, type, day])
}
