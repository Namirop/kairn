// Ce qui fait tourner le produit sans être le produit : travail asynchrone,
// traçabilité des appels modèle, quotas, envois d'emails.

model GenerationJob {
  id      String @id @default(cuid())
  inputId String
  input   Input  @relation(fields: [inputId], references: [id], onDelete: Cascade)

  kind      GenerationKind
  status    JobStatus      @default(QUEUED)
  attempts  Int            @default(0)
  lastError String?        @db.Text

  /// Les Atoms qu'un job de variantes couvre, trois au plus. Vide ailleurs.
  atomIds String[]

  /// Ce job réécrit les questions d'un concept qui en avait déjà.
  ///
  /// C'est lui, et lui seul, que compte le plafond hebdomadaire. Le premier
  /// jeu de questions d'un concept n'est pas une réécriture : le compter
  /// revenait à punir le geste le plus normal du produit — déposer, voir un
  /// concept mal découpé, le corriger dans la minute — d'une semaine sans
  /// questions. La fenêtre part de la première correction, pas du dépôt.
  regeneration Boolean @default(false)

  /// Avant cet instant, le job existe mais ne part pas.
  ///
  /// Un concept ne redemande des questions qu'une fois par semaine. Quand la
  /// demande arrive trop tôt, on ne la jette pas — la jeter laisserait un
  /// concept réécrit sans aucune question, pour toujours. On l'écrit avec la
  /// date à laquelle elle devient légitime, et elle part toute seule ce jour-là.
  /// Nul pour un job qui part tout de suite, c'est-à-dire presque tous.
  notBefore DateTime?

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  aiCalls AiCall[]

  /// Requête du cron de reprise : les jobs à relancer, les plus vieux d'abord.
  @@index([status, createdAt])
  @@index([inputId])
}

/// Une question qui n'allait pas, et tout ce qu'il faut pour comprendre pourquoi.
///
/// C'est la seule instrumentation du produit : les prompts ont été réglés sur
/// onze dépôts d'exemple, et rien d'autre ne dira quand une question part en
/// vrille chez quelqu'un d'autre.
///
/// **Le texte est recopié, pas référencé.** L'utilisateur qui signale une
/// question fausse supprime souvent le concept dans la foulée — c'est le geste
/// naturel —, et c'est précisément ce signalement-là qu'on veut lire. Les liens
/// se détachent, la question reste lisible.
model Signalement {
  id String @id @default(cuid())

  /// Détachés plutôt que supprimés, pour survivre au ménage de leur auteur.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Gardés en clair : ils servent à recouper plusieurs signalements d'un même
  /// dépôt, même une fois les lignes parties.
  atomId    String?
  inputId   String?

  motif       MotifDeSignalement
  /// Facultatif, et c'est voulu : exiger une phrase fait renoncer.
  commentaire String?            @db.Text

  /// Ce qu'on relira, figé au moment du signalement.
  question String @db.Text
  concept  String @db.Text
  reponse  String @db.Text

  format        VariantFormat
  facet         VariantFacet
  model         String
  /// L'empreinte du prompt qui a écrit la question. La donnée la plus utile.
  promptVersion String?

  createdAt DateTime @default(now())

  /// Requête de l'écran d'administration : les plus récents d'abord.
  @@index([createdAt])
}

/// Les gens qui veulent plus que le plafond du jour. Une table et un bouton :
/// un signal de demande gratuit, bien avant d'avoir quoi que ce soit à vendre.
model WaitlistEntry {
  userId  String   @id
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  motif   String?
  askedAt DateTime @default(now())
}

/// Réservation des appels modèle de la journée, en UTC. Une ligne par jour,
/// globale au produit.
///
/// Ce modèle existe parce que compter les lignes d'`AiCall` avant d'émettre est
/// une course : deux appels simultanés lisent la même valeur et passent tous les
/// deux. Ici, prendre sa place est une seule instruction SQL qui incrémente et
/// refuse dans le même mouvement. La place est prise avant l'émission et n'est
/// jamais rendue — un appel qui échoue a pu consommer des tokens.
model AiCallQuota {
  /// Minuit UTC du jour concerné.
  day DateTime @id @db.Date

  reserved Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// La part d'un compte dans les appels du jour, en UTC comme le plafond global.
///
/// Le plafond global protège le budget ; il ne protège personne de son voisin.
/// Un seul compte pouvait le consommer entièrement et fermer la journée de tous
/// les autres. Cette réserve est le second verrou : elle se prend **avant** la
/// place globale, et elle est rendue si la globale est refusée — contrairement
/// à la globale, elle n'a rien émis.
///
/// La journée se compte en UTC, comme `AiCallQuota` et pour la même raison :
/// deux fenêtres qui ne se ferment pas au même instant dérivent l'une de
/// l'autre. Ce n'est pas le compteur que voit l'utilisateur — celui-là est dans
/// `DailyUsage`, dans son calendrier à lui.
model AiUserQuota {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Minuit UTC du jour concerné.
  day    DateTime @db.Date

  reserved Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, day])
}

/// La part du trafic **sans compte** dans les appels du jour.
///
/// Le trafic anonyme n'avait pas de part : n'appartenant à personne, il ne
/// passait que le plafond global. Les deux populations partageaient donc une
/// ressource sans qu'aucune ne soit protégée de l'autre — la landing pouvait
/// fermer la journée aux comptes connectés, et l'inverse était vrai aussi. Ce
/// n'est pas un problème d'argent, le plafond global s'en charge ; c'est un déni
/// de service croisé.
///
/// Une seule ligne par jour, comme `AiCallQuota` : les visiteurs ne sont pas
/// identifiés, et ce qu'on veut borner est le pool entier, pas chacun d'eux —
/// c'est `VISITES_PAR_ADRESSE` qui répartit à l'intérieur du pool.
model AiAnonymousQuota {
  /// Minuit UTC du jour concerné.
  day DateTime @id @db.Date

  reserved Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Une ligne par appel réel au modèle, succès comme échec. C'est le registre
/// qui sert la comptabilité et l'observation ; l'autorisation, elle, passe par
/// `AiCallQuota`.
model AiCall {
  id String @id @default(cuid())

  /// Nuls tous les deux si l'appel ne vient pas d'un utilisateur ou d'un job.
  /// Détachés plutôt que supprimés : la comptabilité survit à la suppression.
  userId String?
  user   User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  jobId  String?
  job    GenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  purpose             String
  /// La lignée qui a servi l'appel : `anthropic` (SDK natif) ou `openrouter`
  /// (pont porté du banc). Nul et non pas absent : un coût ne veut rien dire
  /// si l'on ignore qui l'a facturé, et les multiplicateurs de cache diffèrent
  /// (voir `lib/ai/cout-des-appels.ts`). Défaut `anthropic` pour les lignes écrites
  /// avant le portage — c'était la seule lignée.
  provider            String  @default("anthropic")
  model               String
  /// Entrée facturée plein tarif : ce que le cache n'a pas couvert.
  inputTokens         Int
  /// Entrée écrite dans le cache, facturée un quart plus cher.
  cacheCreationTokens Int     @default(0)
  /// Entrée lue depuis le cache, facturée un dixième.
  cacheReadTokens     Int     @default(0)
  outputTokens        Int
  costUsd             Decimal @db.Decimal(12, 8)
  latencyMs           Int
  success             Boolean
  errorCode           String?
  /// Vrai sur la ligne du succès de repli — l'appel initial (Luna) a échoué,
  /// et Sonnet Anthropic natif a servi à sa place. Comptée séparément dans
  /// l'alerte : au-delà de cinq bascules dans la journée, un email part.
  basculee            Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([basculee, createdAt], map: "AiCall_basculee_createdAt_idx")
}

/// Le budget d'un compte sur sa période, et ce qu'il en a consommé.
///
/// Le plafond gratuit se compte au mois et non au jour : trente concepts par
/// jour tenaient tant que le produit ne servait qu'à son auteur, mais un compte
/// gratuit qui sature tous les jours coûte une trentaine de dollars par mois.
/// Trente par mois ramène le coût maximal d'un compte gratuit sous le demi-dollar.
///
/// La période n'est pas le mois civil : elle est ancrée sur le jour
/// d'inscription — voir `lib/domain/periode-de-quota.ts`. Une ligne par période
/// et par compte, et la clé primaire fait que prendre sa place est une seule
/// instruction qui incrémente et refuse dans le même mouvement.
model MonthlyUsage {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Premier jour de la période, dans le calendrier de l'utilisateur.
  periodStart DateTime @db.Date

  /// Concepts retenus dans la période. C'est le plafond que l'écran annonce.
  concepts Int @default(0)
  /// Dépôts écrits dans la période. Second rideau : chaque dépôt paie une
  /// extraction, quoi qu'elle rende, et un dépôt rejeté n'en rend aucun.
  deposits Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, periodStart])
}

/// Compteurs par utilisateur et par jour, pour les quotas d'usage.
model DailyUsage {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Date locale de l'utilisateur.
  day    DateTime @db.Date

  /// Dépôts écrits dans la journée. Second rideau du quota : chaque dépôt paie
  /// une extraction, quoi qu'elle rende.
  generations Int @default(0)
  /// Concepts retenus dans la journée. C'est le vrai plafond : le concept est
  /// ce qui coûte, et la bonne unité pour l'utilisateur.
  concepts    Int @default(0)
  reviews     Int @default(0)

  /// Fenêtre courte des dépôts, et ce qu'on y a compté.
  ///
  /// Elle vit sur cette ligne et pas ailleurs, et c'est tout l'intérêt :
  /// compter les dépôts récents par une requête à part était une course — dix
  /// envois simultanés lisaient zéro et passaient tous. Ici, la fenêtre est
  /// dans la ligne qu'on verrouille pour prendre sa place, donc l'incrément et
  /// le refus tiennent dans la même instruction. Un redécoupage, qui n'écrit
  /// aucun dépôt, y entre au même titre : c'est la place qui compte, pas la
  /// trace qu'elle laisse.
  depositWindowStart DateTime @default(now())
  depositWindowCount Int      @default(0)

  /// Même mécanisme pour les gestes de révision et d'entraînement. Ils ne
  /// coûtent aucun appel modèle, mais ils écrivent sans limite et lisent large.
  actionWindowStart DateTime @default(now())
  actionWindowCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, day])
}

/// Rend le cron de notification idempotent : la clé primaire interdit deux
/// envois du même type au même utilisateur le même jour.
model EmailDelivery {
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  /// Date locale de l'utilisateur au moment de l'envoi.
  day    DateTime         @db.Date

  sentAt     DateTime @default(now())
  /// Identifiant renvoyé par Resend, pour retrouver un envoi côté fournisseur.
  providerId String?

  @@id([userId, type, day])
}

/// Un visiteur qui dépose avant d'avoir un compte.
///
/// C'est la friction la plus coûteuse du produit qu'on retire : demander un
/// compte avant d'avoir rien montré. On dépose, l'extraction tourne, les
/// concepts s'affichent vraiment — et c'est **ça** qui convertit. Les faire
/// miroiter derrière une inscription fait fermer l'onglet.
///
/// **L'économie tient parce qu'on s'arrête à l'extraction.** Les questions, qui
/// coûtent l'essentiel, ne sont écrites qu'une fois le compte créé. Un visiteur
/// qui repart coûte le prix d'une extraction, et rien de plus.
///
/// C'est le seul endroit du produit qui dépense sans compte identifié : il est
/// donc le plus serré. Un dépôt par session, et une poignée par empreinte
/// d'adresse.
model AnonymousSession {
  id String @id @default(cuid())

  /// Empreinte de l'adresse IP, jamais l'adresse elle-même.
  ///
  /// Ce qu'on veut compter, c'est « combien de dépôts viennent d'ici » — une
  /// empreinte y répond aussi bien qu'une adresse, sans conserver de donnée qui
  /// désigne quelqu'un. Elle est salée par le secret d'application : une
  /// empreinte volée ne se retourne pas en liste d'adresses.
  ipHash String

  /// Non nul dès qu'un compte a réclamé ce dépôt. Ce qui reste nul est du
  /// passage : le cron l'efface au bout de quelques jours.
  claimedAt DateTime?

  createdAt DateTime @default(now())

  inputs Input[]
  atoms  Atom[]

  /// Requête de la limite par adresse : combien de sessions depuis cette empreinte.
  @@index([ipHash, createdAt])
  /// Requête du cron de nettoyage : les non réclamées, les plus vieilles d'abord.
  @@index([claimedAt, createdAt])
}

/// Les réglages d'exploitation, modifiables sans redéploiement.
///
/// Une variable d'environnement se change au déploiement ; ces réglages-là
/// doivent pouvoir se changer *pendant* un incident. `lireLaConfigDeLEnvironnement()` étant déjà
/// relu à chaque appel, une valeur posée ici prend effet immédiatement.
///
/// **Une colonne nulle veut dire « non surchargé »** : la valeur de
/// l'environnement s'applique alors. C'est ce qui garde l'environnement comme
/// source par défaut et cette table comme exception assumée — et ce qui permet
/// de revenir au défaut sans avoir à s'en souvenir.
///
/// `ADMIN_EMAILS` n'est délibérément pas ici : c'est la liste qui décide qui
/// ouvre l'écran d'où l'on modifie cette table. On ne met pas la serrure
/// derrière la porte qu'elle ferme.
model Reglages {
  /// Une seule ligne, et la clé fixe l'y contraint.
  id String @id @default("reglages")

  aiEnabled             Boolean?
  mockAi                Boolean?
  dailyCallCap          Int?
  userDailyCallCap      Int?
  anonymousDailyCallCap Int?
  model                 String?
  maxTokens             Int?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Ce qui a été changé, par qui, et depuis quelle valeur.
///
/// Sans ce journal, « pourquoi la génération est coupée depuis mardi » est une
/// question sans réponse. Un réglage qu'on peut changer en un clic doit laisser
/// une trace, sinon le gain de réactivité se paie en enquêtes.
model ReglageJournal {
  id String @id @default(cuid())

  /// Le nom du réglage, tel qu'il apparaît dans `Reglages`.
  reglage String
  /// Les valeurs sont écrites en clair : nul veut dire « rendu au défaut ».
  avant   String?
  apres   String?

  /// L'adresse de qui a changé, recopiée. Le compte peut disparaître, la trace
  /// doit rester lisible.
  parEmail String

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Une alerte de plafond déjà partie, pour ne pas la renvoyer.
///
/// C'est un verrou, pas un journal, et la nuance décide de sa forme. Sans lui,
/// un plafond de cinquante franchi au trente-cinquième appel enverrait un email
/// à chaque appel suivant — quinze emails identiques dans l'heure, et plus
/// personne ne lit le seizième.
///
/// **L'insertion elle-même sert de verrou.** On tente d'écrire la ligne et on
/// n'envoie que si l'écriture a réussi : un conflit de clé primaire signifie que
/// l'alerte est déjà partie. Pas de lecture préalable, donc pas de fenêtre entre
/// la lecture et l'écriture où deux appels simultanés décideraient tous les deux
/// d'envoyer.
///
/// `cible` porte le compte concerné pour le compteur par compte, et la chaîne
/// vide pour les deux autres : une clé primaire de Postgres n'accepte pas de
/// valeur nulle, et sans cette colonne le premier compte à franchir un seuil
/// aurait consommé l'alerte de tous les autres pour la journée.
///
/// Aucune relation vers `User` : c'est une trace d'exploitation, elle doit
/// survivre à la suppression du compte qui l'a déclenchée.
model AlerteQuota {
  /// Minuit UTC du jour concerné, la même clé que les compteurs qu'elle surveille.
  day      DateTime        @db.Date
  compteur CompteurDeQuota
  cible    String
  /// 70, 90 ou 100. Voir `lib/domain/seuil-de-plafond.ts`.
  seuil    Int

  envoyeeA DateTime @default(now())

  @@id([day, compteur, cible, seuil])
}

/// Ce dont un retour parle. Quatre entrées, parce qu'elles servent à trier une
/// pile, pas à qualifier finement : au-delà, on hésite au moment d'écrire et on
/// renonce.
enum SujetDeRetour {
  /// Quelque chose ne marche pas : une erreur, un écran cassé, un geste sans effet.
  BUG
  /// Une phrase du produit est fausse, obscure, ou sonne mal.
  TEXTE
  /// Ça marche, mais pas comme on s'y attendait. C'est le plus utile des quatre.
  COMPORTEMENT
  AUTRE
}

/// Un retour sur le produit, écrit par qui l'utilise.
///
/// **Ce n'est pas un `Signalement`, et les deux ne doivent pas se confondre.**
/// Un signalement porte sur une question générée : il est déclenché depuis
/// l'écran de révision, il fige ce que la question disait, et il retire cette
/// question du tirage. Un retour porte sur le produit lui-même — une logique qui
/// surprend, un mot de travers, un écran qui déborde — et ne retire rien du
/// tout. Mélanger les deux ferait perdre la seule chose qui rend un signalement
/// exploitable : qu'il désigne un Variant précis.
model Retour {
  id String @id @default(cuid())

  /// Détaché plutôt que supprimé, comme un signalement : un retour survit au
  /// ménage de son auteur, sinon les plus anciens s'effacent en silence, et ce
  /// sont ceux qu'on n'a pas encore traités.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  sujet   SujetDeRetour
  message String        @db.Text

  /// Où ça se passe, dit par la personne. Le formulaire vit dans les réglages,
  /// donc l'adresse courante n'apprendrait rien — c'est la seule façon de savoir
  /// de quel écran on parle.
  ecran String?

  /// Ce qui rend un défaut d'affichage reproductible, et rien de plus : la
  /// largeur de la fenêtre et le navigateur. Aucun contenu déposé n'y passe.
  contexte String?

  /// La capture, gardée. C'est la différence avec celle d'un dépôt, qui part dès
  /// que son texte est lu : ici, c'est l'image elle-même qu'on vient regarder.
  /// Une seule route la sert, et elle est gardée par l'administration.
  captureData      Bytes?
  captureMediaType String?

  /// Ce qui a été lu et traité. Sans marque, un retour est un retour à lire.
  traiteLe DateTime?

  createdAt DateTime @default(now())

  /// Requête de l'écran d'administration : ce qui reste à lire, d'abord.
  @@index([traiteLe, createdAt])
  /// Le plafond par compte se compte sur une fenêtre glissante.
  @@index([userId, createdAt])
}
